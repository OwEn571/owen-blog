{
	auto_https disable_redirects
}

(public_asset_matcher) {
	@public_static_assets path_regexp public_static_assets (?i)^/(?:assets|images|scripts)/.*\.(?:avif|bmp|css|gif|ico|jpe?g|js|mjs|mp4|png|svg|ttf|webm|webp|woff2?)$
}

(pdf_rag_v3_routes) {
	handle /v3* {
		redir /v4 308
	}

	handle /ui/chat-v3* {
		redir /v4 308
	}

	handle /api/v1/agent/v3* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/v1/library/snapshot* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/v1/papers* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8000
	}

	handle /static/chat.css* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8000
	}

	handle /static/chat.js* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8000
	}
}

(pdf_rag_v4_routes) {
	handle /v4* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8001
	}

	# SSE streaming — no compression
	handle /api/v1/v4/chat/stream {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
	handle /api/v1/v4/chat/stream/ {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	handle /api/v1/v4* {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	# SSE streaming (lab path) — no compression
	handle /api/lab/zotero-paper-rag/api/v1/v4/chat/stream {
		uri strip_prefix /api/lab/zotero-paper-rag
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
	handle /api/lab/zotero-paper-rag/api/v1/v4/chat/stream/ {
		uri strip_prefix /api/lab/zotero-paper-rag
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	handle /api/lab/zotero-paper-rag/api/v1/v4* {
		uri strip_prefix /api/lab/zotero-paper-rag
		encode zstd gzip
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
}

:80 {
	@blog_domains host owen571.top www.owen571.top
	handle @blog_domains {
		redir https://owen571.top{uri} 308
	}

	import public_asset_matcher

	handle @public_static_assets {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321 {
			header_down Cache-Control "public, max-age=2592000, immutable"
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321
	}
}

https://www.owen571.top {
	redir https://owen571.top{uri} 308
}

https://owen571.top {
	import pdf_rag_v3_routes
	import pdf_rag_v4_routes

	import public_asset_matcher

	handle @public_static_assets {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321 {
			header_down Cache-Control "public, max-age=2592000, immutable"
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321
	}
}

:8080 {
	import pdf_rag_v4_routes
	import public_asset_matcher

	handle @public_static_assets {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321 {
			header_down Cache-Control "public, max-age=2592000, immutable"
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:4321
	}
}
