---
import { Icon } from "astro-icon/components";

import { labShowcases } from "../data/module-blueprint";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const labProjects = labShowcases
	.filter((item) => item.actionHref.startsWith("/lab/") && !item.actionHref.includes("#"))
	.map((item) => ({
		...item,
		summaryLine: item.stack.slice(0, 3).join(" · "),
		previewSrc:
			item.id === "aios-newsroom"
				? "/api/lab/aios/report.html"
				: item.iframeSrc,
	}));
---

<MainGridLayout
	immersiveLayout={true}
	title="Lab"
	description="系统项目、实验样机与可浏览成果"
>
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>

	<div class="module-page lab-page" style="--module-accent: 86 168 255;">
		<section class="module-hero lab-hero">
			<div class="module-copy">
				<p class="module-eyebrow">Lab</p>
				<h1 class="module-title">在线项目</h1>
				<p class="module-subtitle">已上线系统、实验原型与可浏览结果</p>
				<p class="module-description">
					Lab 只保留项目入口。首页负责展示项目本身，详情页再展开成品、系统面板和项目档案。
				</p>
			</div>
		</section>

			<section class="module-content-shell" id="lab-projects">
					<div class="module-content-head">
						<div>
							<p class="module-stream-label">项目入口</p>
							<h2 class="module-content-title">当前可进入的项目</h2>
							<p class="module-content-description">
								每个项目只保留一句简介和一个结果预览，点击后进入对应的完整展示页。
							</p>
					</div>
				</div>

			<div class="lab-project-grid">
				{
					labProjects.map((item) => (
						<a
							href={item.actionHref}
							class="lab-project-card"
							style={`--lab-accent: ${item.accent};`}
						>
							<div class="lab-project-copy">
								<div class="lab-project-card__top">
									<span class="module-panel-label">{item.kicker}</span>
									<span class="module-panel-badge">{item.status}</span>
								</div>

								<div class="lab-project-card__title">
									<div class="module-panel-icon">
										<Icon name={item.icon} class="text-[1.15rem]" />
									</div>
									<h3>{item.title}</h3>
								</div>

								<p class="lab-project-card__description">{item.description}</p>

								<p class="lab-project-card__meta">{item.summaryLine}</p>

								<span class="lab-project-card__link">
									{item.actionLabel}
									<Icon name="mdi:arrow-top-right" class="text-[1rem]" />
								</span>
							</div>

							<div class="lab-project-visual">
								<div class="lab-project-window">
									<div class="lab-project-window__top">
										<div class="lab-project-window__dots" aria-hidden="true">
											<span></span>
											<span></span>
											<span></span>
										</div>
										<div class="lab-project-window__label">
											{item.title}
										</div>
									</div>

									{
											item.previewSrc ? (
												<iframe
													src={item.previewSrc}
													title={`${item.title} 预览`}
													loading="lazy"
												/>
										) : (
											<div class="lab-project-placeholder" aria-hidden="true">
												<div class="lab-project-placeholder__grid"></div>
												<div class="lab-project-placeholder__orb"></div>
												<div class="lab-project-placeholder__orb"></div>
											</div>
										)
									}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</div>
</MainGridLayout>

<style>
	.lab-page {
		overflow: clip;
		--lab-card-border: rgb(var(--lab-accent) / 0.14);
		--lab-card-bg:
			linear-gradient(180deg, rgba(8, 12, 21, 0.42), rgba(5, 8, 15, 0.18)),
			radial-gradient(circle at top right, rgb(var(--lab-accent) / 0.22), transparent 18rem);
		--lab-card-shadow:
			0 30px 88px rgba(0, 0, 0, 0.22),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
		--lab-card-title: rgba(248, 250, 255, 0.96);
		--lab-card-copy: rgba(223, 231, 244, 0.72);
		--lab-card-muted: rgba(232, 239, 251, 0.72);
		--lab-card-link: rgba(236, 243, 255, 0.9);
		--lab-window-bg: rgba(4, 8, 18, 0.86);
		--lab-window-top-bg:
			linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
		--lab-window-label: rgba(221, 230, 245, 0.62);
		--lab-window-dot: rgba(255, 255, 255, 0.24);
		--lab-window-border: rgba(255, 255, 255, 0.08);
		--lab-chip-bg: rgba(255, 255, 255, 0.05);
	}

	.lab-page::before {
		content: "";
		position: absolute;
		inset: auto auto 76% -8rem;
		width: 22rem;
		height: 22rem;
		border-radius: 999px;
		background: radial-gradient(circle, rgba(92, 168, 255, 0.18), transparent 68%);
		filter: blur(6px);
		pointer-events: none;
	}

	:global(:root:not(.dark)) .lab-page {
		--lab-card-border: rgb(var(--lab-accent) / 0.12);
		--lab-card-bg:
			linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(247, 250, 255, 0.58)),
			radial-gradient(circle at top right, rgb(var(--lab-accent) / 0.12), transparent 18rem);
		--lab-card-shadow:
			0 24px 68px rgba(15, 23, 42, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.84);
		--lab-card-title: rgba(15, 23, 42, 0.92);
		--lab-card-copy: rgba(51, 65, 85, 0.74);
		--lab-card-muted: rgba(51, 65, 85, 0.64);
		--lab-card-link: rgba(30, 41, 59, 0.86);
		--lab-window-bg: rgba(255, 255, 255, 0.86);
		--lab-window-top-bg:
			linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(240, 246, 255, 0.74));
		--lab-window-label: rgba(51, 65, 85, 0.58);
		--lab-window-dot: rgba(15, 23, 42, 0.18);
		--lab-window-border: rgba(148, 163, 184, 0.24);
		--lab-chip-bg: rgba(255, 255, 255, 0.72);
	}

	.lab-hero {
		padding-bottom: 0.6rem;
	}

	.lab-project-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 1rem;
	}

	.lab-project-card {
		display: grid;
		grid-template-columns: minmax(0, 0.92fr) minmax(20rem, 0.78fr);
		gap: 1.15rem;
		align-items: stretch;
		padding: 1.35rem;
		border-radius: 1.9rem;
		border: 1px solid var(--lab-card-border);
		background: var(--lab-card-bg);
		text-decoration: none;
		color: inherit;
		box-shadow: var(--lab-card-shadow);
		transition:
			transform 240ms ease,
			border-color 240ms ease,
			box-shadow 240ms ease;
	}

	.lab-project-card:hover {
		transform: translateY(-4px);
		border-color: rgb(var(--lab-accent) / 0.26);
		box-shadow:
			0 36px 96px rgba(0, 0, 0, 0.28),
			0 0 18px rgb(var(--lab-accent) / 0.12);
	}

	.lab-project-copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		justify-content: center;
	}

	.lab-project-card__top,
	.lab-project-card__title,
	.lab-project-card__link,
	.lab-project-window__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
	}

	.lab-project-card__title {
		justify-content: flex-start;
	}

	.lab-project-card h3 {
		font-size: clamp(1.55rem, 2.5vw, 2.2rem);
		line-height: 1.05;
		font-weight: 700;
		letter-spacing: -0.045em;
		color: var(--lab-card-title);
	}

	.lab-project-card__description {
		max-width: 42rem;
		color: var(--lab-card-copy);
		line-height: 1.85;
	}

	.lab-project-card__meta {
		color: var(--lab-card-muted);
		font-size: 0.86rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.lab-project-card__link {
		justify-content: flex-start;
		color: var(--lab-card-link);
		font-weight: 600;
	}

	.lab-project-visual {
		display: flex;
		align-items: center;
	}

	.lab-project-window {
		width: 100%;
		border-radius: 1.45rem;
		border: 1px solid var(--lab-window-border);
		background: var(--lab-window-bg);
		overflow: hidden;
		box-shadow:
			0 28px 72px rgba(0, 0, 0, 0.24),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	.lab-project-window__top {
		padding: 0.8rem 0.95rem;
		border-bottom: 1px solid var(--lab-window-border);
		background: var(--lab-window-top-bg);
	}

	.lab-project-window__dots {
		display: inline-flex;
		gap: 0.38rem;
	}

	.lab-project-window__dots span {
		width: 0.58rem;
		height: 0.58rem;
		border-radius: 999px;
		background: var(--lab-window-dot);
	}

	.lab-project-window__label {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lab-window-label);
	}

	.lab-project-window iframe {
		display: block;
		width: 100%;
		height: 20rem;
		border: none;
		background: white;
	}

	.lab-project-placeholder {
		position: relative;
		height: 20rem;
		background:
			radial-gradient(circle at 24% 22%, rgba(92, 168, 255, 0.26), transparent 24%),
			radial-gradient(circle at 74% 30%, rgba(88, 226, 201, 0.18), transparent 28%),
			linear-gradient(180deg, rgba(8, 12, 20, 0.98), rgba(6, 9, 16, 0.92));
	}

	.lab-project-placeholder__grid {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
		background-size: 2.8rem 2.8rem;
		mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.76), transparent 88%);
	}

	.lab-project-placeholder__orb {
		position: absolute;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.lab-project-placeholder__orb:nth-child(2) {
		width: 4.4rem;
		height: 4.4rem;
		inset: 50% auto auto 50%;
		transform: translate(-50%, -50%);
		background: radial-gradient(circle, rgba(255, 255, 255, 0.1), transparent 70%);
	}

	.lab-project-placeholder__orb:nth-child(3) {
		width: 12rem;
		height: 12rem;
		inset: 50% auto auto 50%;
		transform: translate(-50%, -50%);
	}

	@media (max-width: 980px) {
		.lab-project-card {
			grid-template-columns: repeat(1, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.lab-project-card {
			padding: 1rem;
			border-radius: 1.45rem;
		}

		.lab-project-window iframe,
		.lab-project-placeholder {
			height: 15rem;
		}
	}
</style>
