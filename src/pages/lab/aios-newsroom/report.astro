---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

import {
	getAiosNewsroomReportEntry,
	getAiosNewsroomSnapshot,
	listAiosNewsroomReports,
} from "../../../server/aios-newsroom";

export const prerender = false;

type AnyRecord = Record<string, any>;

const requestedReportId = Astro.url.searchParams.get("report");
const [snapshot, reportHistory, selectedReportEntry] = await Promise.all([
	getAiosNewsroomSnapshot(),
	listAiosNewsroomReports(120),
	getAiosNewsroomReportEntry(requestedReportId),
]);

const snapshotReport = (snapshot.report as AnyRecord | null) || {};
const report = (selectedReportEntry as AnyRecord | null) || snapshotReport;
const reportMetrics =
	((selectedReportEntry?.metrics as AnyRecord | null) ||
		(snapshotReport.metrics as AnyRecord | null) ||
		{}) as AnyRecord;
const selectedReportId = selectedReportEntry?.reportId || "";
const reportTitle = selectedReportEntry?.reportTitle || report.report_title || "AIOS HTML 成品";
const reportSubtitle =
	selectedReportEntry?.reportSubtitle || report.report_subtitle || "Latest report HTML";
const reportGeneratedAt =
	selectedReportEntry?.generatedAt || report.generated_at || null;
const reportDateLabel =
	selectedReportEntry?.dateLabel || report.date_label || "Latest Report";
const selectedReportHtmlUrl = selectedReportId
	? `/api/lab/aios/report.html?report=${encodeURIComponent(selectedReportId)}`
	: "/api/lab/aios/report.html";

const reportGroups = Array.from(
	reportHistory.reduce((groups, entry) => {
		const key = entry.dateLabel || "未分组";
		const existing = groups.get(key) || [];
		existing.push(entry);
		groups.set(key, existing);
		return groups;
	}, new Map<string, typeof reportHistory>()),
).map(([dateLabel, entries]) => ({ dateLabel, entries }));

function formatDateTime(value: unknown) {
	const text = String(value || "").trim();
	if (!text) {
		return "N/A";
	}
	return text
		.replace("T", " ")
		.replace(/\.\d+/, "")
		.replace(/\+08:00$/, " CST");
}

const htmlSummaryLine = [
	reportMetrics.total_articles
		? `${reportMetrics.total_articles} 篇成稿`
		: "",
	reportMetrics.active_sections
		? `${reportMetrics.active_sections} 个栏目`
		: "",
	reportMetrics.total_sources
		? `${reportMetrics.total_sources} 条参考信源`
		: "",
]
	.filter(Boolean)
	.join(" · ");
---

<MainGridLayout
	immersiveLayout={true}
	title={String(reportTitle)}
	description="AIOS 日报 HTML 成品详情页，支持按日期和时间切换历史日报"
>
	<script>
		import("../../../scripts/right-sidebar-layout.js");
	</script>

	<div class="module-page newsroom-detail-page" style="--module-accent: 86 168 255;">
		<section class="module-hero newsroom-detail-hero">
			<div class="module-copy">
				<p class="module-eyebrow">AIOS / HTML 成品</p>
				<h1 class="module-title">{reportTitle}</h1>
				<p class="module-subtitle">
					{reportSubtitle}
				</p>
				<p class="module-description">
					这里保留最终日报的完整 HTML 展示。主页面已经不再嵌它，这一页专门负责详细查看成品。
				</p>

				<div class="newsroom-detail-actions">
					<a href="/lab/aios-newsroom/" class="newsroom-detail-action">
						<Icon name="mdi:arrow-left" class="text-[1.05rem]" />
						<span>返回 AIOS 展示页</span>
					</a>
					<a href={selectedReportHtmlUrl} class="newsroom-detail-action">
						<Icon name="mdi:open-in-new" class="text-[1.05rem]" />
						<span>独立打开当前 HTML</span>
					</a>
				</div>
			</div>
		</section>

		<section class="module-content-shell newsroom-detail-shell">
			<div class="module-content-head">
				<div>
					<p class="module-stream-label">HTML Result</p>
					<h2 class="module-content-title">最终日报 HTML</h2>
					<p class="module-content-description">
						保留原始版式，只做主题桥接，确保夜间模式下也能正常阅读。
					</p>
				</div>
				<span class="module-panel-badge">
					{reportDateLabel}
				</span>
			</div>

			<div class="newsroom-detail-meta">
				<span>{htmlSummaryLine || "当前版本日报"}</span>
				<span>{formatDateTime(reportGeneratedAt)}</span>
				<span>{reportHistory.length} 份历史日报</span>
			</div>

			{
				reportHistory.length > 0 && (
					<form class="newsroom-detail-picker" method="get">
						<div class="newsroom-detail-picker__label">
							<Icon name="mdi:calendar-clock-outline" class="text-[1rem]" />
							<span>选择日报时间</span>
						</div>
						<div class="newsroom-detail-picker__controls">
							<select
								name="report"
								class="newsroom-detail-picker__select"
								onchange="this.form.submit()"
							>
								{reportGroups.map((group) => (
									<optgroup label={group.dateLabel}>
										{group.entries.map((entry) => (
											<option
												value={entry.reportId}
												selected={entry.reportId === selectedReportId}
											>
												{`${entry.timeLabel} · ${entry.reportTitle}`}
											</option>
										))}
									</optgroup>
								))}
							</select>
							<button type="submit" class="newsroom-detail-picker__button">
								查看
							</button>
							<a href="/lab/aios-newsroom/report/" class="newsroom-detail-picker__latest">
								最新一份
							</a>
						</div>
						<p class="newsroom-detail-picker__hint">
							同一天如果多次生成日报，会按具体时间列出。选择后页面会切换到对应的历史 HTML。
						</p>
					</form>
				)
			}

			<div class="newsroom-detail-frame">
				<iframe
					src={selectedReportHtmlUrl}
					title={String(reportTitle || "AIOS report")}
					loading="eager"
				/>
			</div>
		</section>
	</div>
</MainGridLayout>

<style>
	.newsroom-detail-page {
		overflow: clip;
		--newsroom-action-bg: rgba(255, 255, 255, 0.05);
		--newsroom-action-border: rgba(92, 168, 255, 0.16);
		--newsroom-action-text: rgba(240, 246, 255, 0.86);
		--newsroom-action-hover-bg: rgba(255, 255, 255, 0.08);
		--newsroom-action-hover-border: rgba(92, 168, 255, 0.28);
		--newsroom-muted: rgba(219, 229, 244, 0.68);
		--newsroom-frame-bg: rgba(5, 10, 24, 0.76);
		--newsroom-frame-border: rgba(92, 168, 255, 0.14);
	}

	:global(:root:not(.dark)) .newsroom-detail-page {
		--newsroom-action-bg: rgba(255, 255, 255, 0.74);
		--newsroom-action-border: rgba(148, 163, 184, 0.24);
		--newsroom-action-text: rgba(30, 41, 59, 0.84);
		--newsroom-action-hover-bg: rgba(255, 255, 255, 0.92);
		--newsroom-action-hover-border: rgba(92, 168, 255, 0.26);
		--newsroom-muted: rgba(51, 65, 85, 0.66);
		--newsroom-frame-bg: rgba(255, 255, 255, 0.86);
		--newsroom-frame-border: rgba(148, 163, 184, 0.22);
	}

	.newsroom-detail-hero {
		padding-bottom: 0.5rem;
	}

	.newsroom-detail-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.newsroom-detail-action {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.72rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--newsroom-action-border);
		background: var(--newsroom-action-bg);
		color: var(--newsroom-action-text);
		text-decoration: none;
		transition:
			transform 220ms ease,
			background-color 220ms ease,
			border-color 220ms ease;
	}

	.newsroom-detail-action:hover {
		transform: translateY(-2px);
		border-color: var(--newsroom-action-hover-border);
		background: var(--newsroom-action-hover-bg);
	}

	.newsroom-detail-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-bottom: 1rem;
	}

	.newsroom-detail-meta span {
		display: inline-flex;
		align-items: center;
		padding: 0.5rem 0.85rem;
		border-radius: 999px;
		background: var(--newsroom-action-bg);
		border: 1px solid var(--newsroom-action-border);
		color: var(--newsroom-muted);
		font-size: 0.88rem;
	}

	.newsroom-detail-picker {
		margin-bottom: 1rem;
		padding: 1rem;
		border-radius: 1.1rem;
		border: 1px solid var(--newsroom-action-border);
		background: var(--newsroom-action-bg);
	}

	.newsroom-detail-picker__label {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.75rem;
		color: var(--newsroom-action-text);
		font-weight: 600;
	}

	.newsroom-detail-picker__controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: center;
	}

	.newsroom-detail-picker__select {
		flex: 1 1 18rem;
		min-width: 16rem;
		padding: 0.8rem 0.9rem;
		border-radius: 0.9rem;
		border: 1px solid var(--newsroom-action-border);
		background: rgba(255, 255, 255, 0.9);
		color: #0f172a;
		font: inherit;
	}

	.newsroom-detail-picker__button,
	.newsroom-detail-picker__latest {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.78rem 1rem;
		border-radius: 0.9rem;
		border: 1px solid var(--newsroom-action-border);
		background: var(--newsroom-action-bg);
		color: var(--newsroom-action-text);
		font: inherit;
		text-decoration: none;
		cursor: pointer;
	}

	.newsroom-detail-picker__hint {
		margin: 0.75rem 0 0;
		color: var(--newsroom-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.newsroom-detail-frame {
		padding: 0.55rem;
		border-radius: 1.45rem;
		border: 1px solid var(--newsroom-frame-border);
		background: var(--newsroom-frame-bg);
	}

	.newsroom-detail-frame iframe {
		display: block;
		width: 100%;
		height: 88vh;
		min-height: 52rem;
		border: none;
		border-radius: 1rem;
		background: white;
	}

	@media (max-width: 640px) {
		.newsroom-detail-actions {
			flex-direction: column;
		}

		.newsroom-detail-action {
			width: 100%;
			justify-content: center;
		}

		.newsroom-detail-picker__controls {
			flex-direction: column;
			align-items: stretch;
		}

		.newsroom-detail-picker__select {
			min-width: 0;
			width: 100%;
		}

		.newsroom-detail-picker__button,
		.newsroom-detail-picker__latest {
			width: 100%;
		}

		.newsroom-detail-frame iframe {
			height: 76vh;
			min-height: 42rem;
		}
	}
</style>
