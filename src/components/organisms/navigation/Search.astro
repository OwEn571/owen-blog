---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";
---

<div data-owen-search-root class="owen-search-root">
	<button
		type="button"
		id="owen-search-launch-desktop"
		class="owen-search-launch owen-search-launch--desktop hidden lg:inline-flex"
		aria-label="打开站内搜索"
	>
		<span class="owen-search-launch__icon" aria-hidden="true">
			<Icon name="material-symbols:search-rounded" class="text-[1.2rem]" />
		</span>
		<span class="owen-search-launch__copy">
			<strong>搜索内容</strong>
			<span>文章、项目、笔记与段落</span>
		</span>
		<span class="owen-search-launch__shortcut" aria-hidden="true">Ctrl K</span>
	</button>

	<button
		type="button"
		id="owen-search-launch-mobile"
		class="owen-search-launch owen-search-launch--mobile lg:hidden"
		aria-label="打开站内搜索"
	>
		<Icon name="material-symbols:search-rounded" class="text-[1.25rem]" />
	</button>

	<div
		id="owen-search-modal"
		class="owen-search-dialog owen-search-dialog--closed"
		aria-hidden="true"
	>
		<button
			type="button"
			class="owen-search-dialog__backdrop"
			data-search-dismiss
			aria-label="关闭搜索"
		></button>

		<div class="owen-search-dialog__viewport">
			<section
				id="owen-search-dialog-panel"
				class="owen-search-dialog__panel"
				role="dialog"
				aria-modal="true"
				aria-labelledby="owen-search-title"
			>
				<div class="owen-search-dialog__header">
					<div class="owen-search-dialog__title-group">
						<p class="owen-search-dialog__eyebrow">Content Search</p>
						<h2 id="owen-search-title" class="owen-search-dialog__title">
							站内搜索
						</h2>
						<p class="owen-search-dialog__description">
							支持标题、标签、分类和正文段落，并直接定位到命中的标题位置。
						</p>
					</div>
					<button
						type="button"
						id="owen-search-close"
						class="owen-search-close"
						aria-label="关闭搜索"
					>
						<Icon name="material-symbols:close-rounded" class="text-[1.2rem]" />
					</button>
				</div>

				<div class="owen-search-input-shell">
					<div class="owen-search-input-shell__icon" aria-hidden="true">
						<Icon name="material-symbols:search-rounded" class="text-[1.2rem]" />
					</div>
					<input
						id="owen-search-input"
						class="owen-search-input"
						type="search"
						placeholder={i18n(I18nKey.search)}
						autocomplete="off"
						spellcheck="false"
					/>
					<div class="owen-search-input-shell__hint" aria-hidden="true">
						<span>ESC</span>
					</div>
				</div>

				<div class="owen-search-helper">
					<span>结果按“文章页 / 段落定位”区分</span>
					<span>↑ ↓ 切换结果</span>
					<span>Enter 打开</span>
				</div>

				<div id="owen-search-results" class="owen-search-results"></div>
			</section>
		</div>
	</div>
</div>

<style is:global>
	.owen-search-root {
		display: flex;
		align-items: center;
	}

	.owen-search-launch {
		position: relative;
		align-items: center;
		border-radius: 1.1rem;
		border: 1px solid rgba(118, 156, 255, 0.14);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(247, 250, 255, 0.52)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.12), transparent 12rem);
		color: rgba(15, 23, 42, 0.86);
		box-shadow:
			0 18px 42px rgba(15, 23, 42, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.82);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease,
			background 180ms ease;
	}

	.owen-search-launch:hover,
	.owen-search-launch:focus-visible {
		transform: translateY(-1px);
		border-color: rgba(118, 156, 255, 0.24);
		box-shadow:
			0 22px 52px rgba(15, 23, 42, 0.12),
			0 0 16px rgba(118, 156, 255, 0.12);
		outline: none;
	}

	.owen-search-launch--desktop {
		gap: 0.8rem;
		min-width: 15rem;
		height: 2.75rem;
		padding: 0.45rem 0.7rem 0.45rem 0.75rem;
	}

	.owen-search-launch--mobile {
		display: inline-flex;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
	}

	.owen-search-launch__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.95rem;
		height: 1.95rem;
		border-radius: 0.8rem;
		background: rgba(118, 156, 255, 0.1);
		color: var(--primary);
		flex-shrink: 0;
	}

	.owen-search-launch__copy {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.1;
		text-align: left;
	}

	.owen-search-launch__copy strong {
		font-size: 0.9rem;
		font-weight: 720;
		color: rgba(15, 23, 42, 0.88);
	}

	.owen-search-launch__copy span {
		font-size: 0.72rem;
		color: rgba(51, 65, 85, 0.68);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.owen-search-launch__shortcut {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 1.75rem;
		padding: 0 0.55rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(255, 255, 255, 0.72);
		color: rgba(51, 65, 85, 0.62);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		flex-shrink: 0;
	}

	.owen-search-dialog {
		position: fixed;
		inset: 0;
		display: grid;
		grid-template-areas: "search-stack";
		z-index: 2200 !important;
		isolation: isolate;
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition: opacity 180ms ease;
	}

	.owen-search-dialog--closed {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.owen-search-dialog__backdrop {
		grid-area: search-stack;
		position: absolute;
		inset: 0;
		z-index: 0;
		border: none;
		background:
			radial-gradient(circle at top, rgba(118, 156, 255, 0.12), transparent 28rem),
			rgba(5, 10, 18, 0.46);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	.owen-search-dialog__viewport {
		grid-area: search-stack;
		position: relative;
		z-index: 1;
		display: flex;
		width: 100%;
		min-height: 100dvh;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(4.5rem, 12vh, 7rem) 1rem 2rem;
		pointer-events: none;
	}

	.owen-search-dialog__panel {
		position: relative;
		display: flex;
		flex-direction: column;
		width: min(100%, 56rem);
		max-height: min(82dvh, 52rem);
		overflow: hidden;
		border-radius: 1.9rem;
		border: 1px solid rgba(118, 156, 255, 0.18);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(248, 250, 255, 0.78)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.12), transparent 16rem);
		box-shadow:
			0 34px 90px rgba(15, 23, 42, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.82);
		padding: 1.1rem;
		color: rgba(15, 23, 42, 0.92);
		pointer-events: auto;
	}

	.owen-search-dialog__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.2rem 0.1rem 0.9rem;
	}

	.owen-search-dialog__title-group {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
	}

	.owen-search-dialog__eyebrow {
		font-size: 0.72rem;
		font-weight: 720;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(69, 97, 186, 0.74);
	}

	.owen-search-dialog__title {
		font-size: clamp(1.35rem, 2vw, 1.75rem);
		font-weight: 780;
		line-height: 1.05;
	}

	.owen-search-dialog__description {
		color: rgba(51, 65, 85, 0.7);
		font-size: 0.92rem;
		line-height: 1.55;
		max-width: 40rem;
	}

	.owen-search-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(148, 163, 184, 0.2);
		background: rgba(255, 255, 255, 0.76);
		color: rgba(51, 65, 85, 0.72);
		flex-shrink: 0;
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.owen-search-close:hover,
	.owen-search-close:focus-visible {
		transform: translateY(-1px);
		border-color: rgba(118, 156, 255, 0.24);
		color: var(--primary);
		outline: none;
	}

	.owen-search-input-shell {
		position: relative;
		display: flex;
		align-items: center;
		min-height: 4rem;
		border-radius: 1.4rem;
		border: 1px solid rgba(118, 156, 255, 0.2);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(245, 248, 255, 0.8)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.12), transparent 12rem);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.86),
			0 14px 34px rgba(15, 23, 42, 0.06);
		padding: 0 0.95rem;
	}

	.owen-search-input-shell:focus-within {
		border-color: rgba(118, 156, 255, 0.34);
		box-shadow:
			0 0 0 4px rgba(118, 156, 255, 0.12),
			inset 0 1px 0 rgba(255, 255, 255, 0.86);
	}

	.owen-search-input-shell__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.8rem;
		color: rgba(69, 97, 186, 0.82);
		flex-shrink: 0;
	}

	.owen-search-input {
		width: 100%;
		min-width: 0;
		height: 4rem;
		border: none;
		outline: none;
		background: transparent;
		color: inherit;
		font-size: 1rem;
		font-weight: 560;
	}

	.owen-search-input::placeholder {
		color: rgba(51, 65, 85, 0.42);
	}

	.owen-search-input-shell__hint {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2rem;
		padding: 0 0.65rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(255, 255, 255, 0.72);
		color: rgba(51, 65, 85, 0.58);
		font-size: 0.74rem;
		font-weight: 750;
		letter-spacing: 0.05em;
		flex-shrink: 0;
	}

	.owen-search-helper {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		padding: 0.85rem 0.2rem 0.15rem;
	}

	.owen-search-helper span {
		display: inline-flex;
		align-items: center;
		height: 1.9rem;
		padding: 0 0.8rem;
		border-radius: 999px;
		background: rgba(118, 156, 255, 0.08);
		color: rgba(51, 65, 85, 0.68);
		font-size: 0.76rem;
		font-weight: 650;
	}

	.owen-search-results {
		margin-top: 0.95rem;
		min-height: 15rem;
		overflow: auto;
		padding-right: 0.2rem;
		scrollbar-gutter: stable;
	}

	.owen-search-state,
	.owen-search-results-list {
		display: grid;
		gap: 0.75rem;
	}

	.owen-search-state {
		padding: 0.25rem 0;
	}

	.owen-search-state__card {
		border-radius: 1.35rem;
		border: 1px solid rgba(118, 156, 255, 0.12);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(247, 250, 255, 0.56)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.08), transparent 10rem);
		padding: 1rem 1.05rem;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
	}

	.owen-search-state__card strong {
		display: block;
		font-size: 0.98rem;
		font-weight: 720;
		color: rgba(15, 23, 42, 0.9);
	}

	.owen-search-state__card p {
		margin-top: 0.22rem;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgba(51, 65, 85, 0.68);
	}

	.owen-search-results__head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0 0.2rem 0.15rem;
	}

	.owen-search-results__summary-group {
		display: grid;
		gap: 0.18rem;
		min-width: 0;
	}

	.owen-search-results__summary {
		font-size: 0.78rem;
		font-weight: 730;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(69, 97, 186, 0.72);
	}

	.owen-search-results__breakdown {
		font-size: 0.84rem;
		font-weight: 620;
		color: rgba(51, 65, 85, 0.62);
	}

	.owen-search-results__meta {
		font-size: 0.76rem;
		color: rgba(51, 65, 85, 0.56);
		white-space: nowrap;
		padding-bottom: 0.05rem;
	}

	.owen-search-result {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.95rem;
		width: 100%;
		text-align: left;
		padding: 1rem 1.1rem 1rem 1.2rem;
		border-radius: 1.45rem;
		border: 1px solid rgba(118, 156, 255, 0.12);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(247, 250, 255, 0.6)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.08), transparent 10rem);
		box-shadow:
			0 16px 32px rgba(15, 23, 42, 0.06),
			inset 0 1px 0 rgba(255, 255, 255, 0.78);
		transition:
			transform 180ms ease,
			border-color 180ms ease,
			box-shadow 180ms ease;
	}

	.owen-search-result:hover,
	.owen-search-result:focus-visible,
	.owen-search-result.is-active {
		transform: translateY(-2px);
		border-color: rgba(118, 156, 255, 0.28);
		box-shadow:
			0 20px 44px rgba(15, 23, 42, 0.1),
			0 0 18px rgba(118, 156, 255, 0.1);
		outline: none;
	}

	.owen-search-result::before {
		content: "";
		position: absolute;
		left: 0.7rem;
		top: 1rem;
		bottom: 1rem;
		width: 0.22rem;
		border-radius: 999px;
		background: linear-gradient(180deg, rgba(118, 156, 255, 0.18), rgba(118, 156, 255, 0.68));
		opacity: 0.5;
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.owen-search-result:hover::before,
	.owen-search-result:focus-visible::before,
	.owen-search-result.is-active::before {
		opacity: 1;
		transform: scaleY(1.03);
	}

	.owen-search-result__main {
		display: grid;
		gap: 0.62rem;
		min-width: 0;
	}

	.owen-search-result__meta-row,
	.owen-search-result__context {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.owen-search-result__kind,
	.owen-search-result__scope,
	.owen-search-result__context-chip {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 0.3rem 0.65rem;
		font-size: 0.72rem;
		font-weight: 700;
	}

	.owen-search-result__kind {
		background: rgba(69, 97, 186, 0.12);
		color: rgba(69, 97, 186, 0.82);
	}

	.owen-search-result__scope {
		background: rgba(118, 156, 255, 0.08);
		color: rgba(51, 65, 85, 0.72);
		max-width: min(22rem, 100%);
	}

	.owen-search-result__context-chip {
		background: rgba(148, 163, 184, 0.12);
		color: rgba(51, 65, 85, 0.62);
	}

	.owen-search-result__title {
		font-size: 1.02rem;
		font-weight: 760;
		line-height: 1.38;
		color: rgba(15, 23, 42, 0.92);
	}

	.owen-search-result__location {
		font-size: 0.84rem;
		line-height: 1.55;
		color: rgba(69, 97, 186, 0.72);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.owen-search-result__excerpt {
		font-size: 0.92rem;
		line-height: 1.68;
		color: rgba(51, 65, 85, 0.72);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.owen-search-result__aside {
		display: grid;
		align-content: space-between;
		justify-items: end;
		gap: 0.8rem;
		min-width: 5.25rem;
	}

	.owen-search-result__action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 4.25rem;
		height: 2rem;
		padding: 0 0.8rem;
		border-radius: 999px;
		border: 1px solid rgba(118, 156, 255, 0.12);
		background: rgba(255, 255, 255, 0.7);
		color: rgba(69, 97, 186, 0.72);
		font-size: 0.72rem;
		font-weight: 760;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.owen-search-result__jump {
		font-size: 0.74rem;
		font-weight: 650;
		color: rgba(51, 65, 85, 0.52);
		text-align: right;
	}

	.owen-search-highlight {
		padding: 0 0.18rem;
		border-radius: 0.35rem;
		background: rgba(118, 156, 255, 0.18);
		color: rgba(28, 42, 102, 0.96);
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}

	:global(.owen-search-target-flash),
	:global(.custom-md :is(h1, h2, h3, h4, h5, h6):target) {
		animation: owen-search-target-glow 1.8s ease;
	}

	@keyframes owen-search-target-glow {
		0% {
			box-shadow: 0 0 0 0 rgba(118, 156, 255, 0.38);
			background: rgba(118, 156, 255, 0.18);
		}
		100% {
			box-shadow: 0 0 0 18px rgba(118, 156, 255, 0);
			background: transparent;
		}
	}

	:global(.dark) .owen-search-launch {
		border-color: rgba(255, 255, 255, 0.08);
		background:
			linear-gradient(180deg, rgba(12, 16, 25, 0.72), rgba(7, 10, 16, 0.48)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.16), transparent 12rem);
		color: rgba(238, 243, 255, 0.9);
		box-shadow:
			0 22px 50px rgba(0, 0, 0, 0.22),
			inset 0 1px 0 rgba(255, 255, 255, 0.08);
	}

	:global(.dark) .owen-search-launch__copy strong {
		color: rgba(244, 247, 255, 0.94);
	}

	:global(.dark) .owen-search-launch__copy span,
	:global(.dark) .owen-search-launch__shortcut {
		color: rgba(214, 226, 255, 0.62);
	}

	:global(.dark) .owen-search-launch__shortcut {
		border-color: rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.04);
	}

	:global(.dark) .owen-search-dialog__panel {
		border-color: rgba(255, 255, 255, 0.08);
		background:
			linear-gradient(180deg, rgba(9, 13, 20, 0.94), rgba(5, 8, 14, 0.88)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.14), transparent 16rem);
		box-shadow:
			0 40px 100px rgba(0, 0, 0, 0.34),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
		color: rgba(236, 243, 255, 0.92);
	}

	:global(.dark) .owen-search-dialog__description,
	:global(.dark) .owen-search-helper span,
	:global(.dark) .owen-search-results__breakdown,
	:global(.dark) .owen-search-results__meta,
	:global(.dark) .owen-search-state__card p,
	:global(.dark) .owen-search-result__excerpt,
	:global(.dark) .owen-search-result__scope,
	:global(.dark) .owen-search-result__context-chip,
	:global(.dark) .owen-search-result__jump {
		color: rgba(214, 226, 255, 0.66);
	}

	:global(.dark) .owen-search-close,
	:global(.dark) .owen-search-input-shell,
	:global(.dark) .owen-search-state__card,
	:global(.dark) .owen-search-result {
		border-color: rgba(255, 255, 255, 0.08);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02)),
			radial-gradient(circle at top right, rgba(118, 156, 255, 0.08), transparent 10rem);
		box-shadow:
			0 18px 42px rgba(0, 0, 0, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
	}

	:global(.dark) .owen-search-input {
		color: rgba(242, 246, 255, 0.92);
	}

	:global(.dark) .owen-search-input::placeholder {
		color: rgba(214, 226, 255, 0.34);
	}

	:global(.dark) .owen-search-result__title {
		color: rgba(244, 247, 255, 0.94);
	}

	:global(.dark) .owen-search-result__location {
		color: rgba(170, 195, 255, 0.76);
	}

	:global(.dark) .owen-search-result__action {
		border-color: rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.04);
		color: rgba(194, 214, 255, 0.8);
	}

	:global(.dark) .owen-search-highlight {
		background: rgba(118, 156, 255, 0.22);
		color: rgba(239, 244, 255, 0.96);
	}

	@media (max-width: 1279px) {
		.owen-search-dialog__viewport {
			padding-top: max(4.75rem, env(safe-area-inset-top) + 3.5rem);
		}
	}

	@media (max-width: 820px) {
		.owen-search-dialog__viewport {
			padding: max(4.75rem, env(safe-area-inset-top) + 3.5rem) 0.85rem 1.25rem;
		}

		.owen-search-dialog__panel {
			border-radius: 1.45rem;
			padding: 0.9rem;
			max-height: min(84dvh, 46rem);
		}

		.owen-search-dialog__header {
			padding-bottom: 0.8rem;
		}

		.owen-search-dialog__description {
			font-size: 0.88rem;
		}

		.owen-search-input-shell {
			min-height: 3.6rem;
		}

		.owen-search-input {
			height: 3.6rem;
			font-size: 0.96rem;
		}

		.owen-search-input-shell__hint {
			display: none;
		}

		.owen-search-results {
			padding-right: 0;
		}

		.owen-search-results__head {
			flex-direction: column;
			align-items: flex-start;
		}

		.owen-search-result {
			grid-template-columns: minmax(0, 1fr);
		}

		.owen-search-result__aside {
			grid-template-columns: repeat(2, auto);
			align-items: center;
			justify-content: space-between;
			justify-items: start;
			min-width: 0;
		}

		.owen-search-result__jump {
			text-align: left;
		}
	}
</style>

<script is:inline define:vars={{ searchApiUrl: url("/api/search.json") }}>
	(() => {
		const searchWindow = window;
		const currentScript = document.currentScript;
		const currentRoot =
			currentScript instanceof HTMLScriptElement
				? currentScript.closest("[data-owen-search-root]")
				: null;

		const state =
			searchWindow.__owenSearchModalState ||
			(searchWindow.__owenSearchModalState = {
				root: null,
				desktopTrigger: null,
				mobileTrigger: null,
				dialog: null,
				panel: null,
				closeButton: null,
				backdrop: null,
				input: null,
				results: null,
				keyword: "",
				activeIndex: -1,
				items: [],
				requestId: 0,
				debounceTimer: 0,
				activeController: null,
				isOpen: false,
				isComposing: false,
				globalListenersBound: false,
			});

		if (currentRoot instanceof HTMLElement) {
			state.root = currentRoot;
		}

		const escapeHtml = (value) =>
			String(value || "")
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll('"', "&quot;")
				.replaceAll("'", "&#39;");

		const escapeRegExp = (value) =>
			String(value || "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

		const getQueryTokens = (value) => {
			const normalized = String(value || "").trim();
			if (!normalized) {
				return [];
			}

			const parts = normalized
				.split(/\s+/)
				.map((item) => item.trim())
				.filter(Boolean);
			const tokens = normalized.length > 1 ? [normalized, ...parts] : parts;
			return Array.from(new Set(tokens)).sort((left, right) => right.length - left.length);
		};

		const highlightQuery = (value, query) => {
			const plain = String(value || "").trim();
			if (!plain) {
				return "";
			}

			let html = escapeHtml(plain);
			for (const token of getQueryTokens(query)) {
				if (!token) {
					continue;
				}
				const pattern = new RegExp(escapeRegExp(escapeHtml(token)), "gi");
				html = html.replace(
					pattern,
					(match) => `<mark class="owen-search-highlight">${match}</mark>`,
				);
			}
			return html;
		};

		const resolveRoot = () => {
			if (state.root instanceof HTMLElement && state.root.isConnected) {
				return state.root;
			}

			const roots = document.querySelectorAll("[data-owen-search-root]");
			const latest = roots[roots.length - 1];
			state.root = latest instanceof HTMLElement ? latest : null;
			return state.root;
		};

		const resolveDialog = (root) => {
			const dialogs = Array.from(document.querySelectorAll("#owen-search-modal")).filter(
				(node) => node instanceof HTMLElement,
			);
			const rootDialog = root.querySelector("#owen-search-modal");
			const existingPortal = dialogs.find(
				(node) =>
					node instanceof HTMLElement &&
					node.dataset.owenSearchPortal === "true" &&
					node.isConnected,
			);
			const activeDialog =
				rootDialog instanceof HTMLElement
					? rootDialog
					: existingPortal instanceof HTMLElement
						? existingPortal
						: dialogs[dialogs.length - 1];

			if (!(activeDialog instanceof HTMLElement)) {
				return null;
			}

			dialogs.forEach((node) => {
				if (node instanceof HTMLElement && node !== activeDialog) {
					node.remove();
				}
			});

			activeDialog.dataset.owenSearchPortal = "true";
			if (activeDialog.parentElement !== document.body) {
				document.body.append(activeDialog);
			}

			return activeDialog;
		};

		const refreshDom = () => {
			const root = resolveRoot();
			if (!(root instanceof HTMLElement)) {
				return false;
			}

			const desktopTrigger = root.querySelector("#owen-search-launch-desktop");
			const mobileTrigger = root.querySelector("#owen-search-launch-mobile");
			const dialog = resolveDialog(root);
			const panel = dialog?.querySelector("#owen-search-dialog-panel");
			const closeButton = dialog?.querySelector("#owen-search-close");
			const backdrop = dialog?.querySelector("[data-search-dismiss]");
			const input = dialog?.querySelector("#owen-search-input");
			const results = dialog?.querySelector("#owen-search-results");

			if (
				!(desktopTrigger instanceof HTMLButtonElement) ||
				!(mobileTrigger instanceof HTMLButtonElement) ||
				!(dialog instanceof HTMLElement) ||
				!(panel instanceof HTMLElement) ||
				!(closeButton instanceof HTMLButtonElement) ||
				!(backdrop instanceof HTMLButtonElement) ||
				!(input instanceof HTMLInputElement) ||
				!(results instanceof HTMLElement)
			) {
				return false;
			}

			state.desktopTrigger = desktopTrigger;
			state.mobileTrigger = mobileTrigger;
			state.dialog = dialog;
			state.panel = panel;
			state.closeButton = closeButton;
			state.backdrop = backdrop;
			state.input = input;
			state.results = results;
			if (input.value !== state.keyword) {
				input.value = state.keyword;
			}
			return true;
		};

		const setDialogState = (open) => {
			if (!refreshDom() || !(state.dialog instanceof HTMLElement)) {
				return;
			}

			state.isOpen = open;
			state.dialog.classList.toggle("owen-search-dialog--closed", !open);
			state.dialog.setAttribute("aria-hidden", open ? "false" : "true");
			document.documentElement.classList.toggle("owen-search-open", open);
			document.body.style.overflow = open ? "hidden" : "";
		};

		const focusInput = () => {
			if (!(state.input instanceof HTMLInputElement)) {
				return;
			}
			window.setTimeout(() => {
				if (!(state.input instanceof HTMLInputElement)) {
					return;
				}
				state.input.focus({ preventScroll: true });
				state.input.select();
			}, 0);
		};

		const renderIdleState = () => {
			if (!(state.results instanceof HTMLElement)) {
				return;
			}

			state.results.innerHTML = `
				<div class="owen-search-state">
					<div class="owen-search-state__card">
						<strong>从标题、标签到正文段落都能搜</strong>
						<p>输入关键词后，结果会直接区分“文章页”和“段落定位”，点击后跳到对应位置。</p>
					</div>
					<div class="owen-search-state__card">
						<strong>快捷方式</strong>
						<p>桌面端可以直接按 <code>Ctrl / Cmd + K</code> 打开搜索，按 <code>Escape</code> 关闭。</p>
					</div>
				</div>
			`;
			state.activeIndex = -1;
			state.items = [];
		};

		const renderLoadingState = () => {
			if (!(state.results instanceof HTMLElement)) {
				return;
			}

			state.results.innerHTML = `
				<div class="owen-search-state">
					<div class="owen-search-state__card">
						<strong>正在搜索</strong>
						<p>正在整理标题、标签和正文段落的匹配结果。</p>
					</div>
				</div>
			`;
		};

		const renderEmptyState = () => {
			if (!(state.results instanceof HTMLElement)) {
				return;
			}

			state.results.innerHTML = `
				<div class="owen-search-state">
					<div class="owen-search-state__card">
						<strong>没有找到匹配内容</strong>
						<p>可以试试文章标题、专题名、标签，或者直接搜正文里的关键句。</p>
					</div>
				</div>
			`;
			state.activeIndex = -1;
		};

		const syncActiveResult = () => {
			if (!(state.results instanceof HTMLElement)) {
				return;
			}

			const cards = Array.from(
				state.results.querySelectorAll("[data-search-result-index]"),
			);

			cards.forEach((node, index) => {
				const isActive = index === state.activeIndex;
				node.classList.toggle("is-active", isActive);
				node.setAttribute("aria-selected", isActive ? "true" : "false");
				if (isActive) {
					node.scrollIntoView({ block: "nearest" });
				}
			});
		};

		const renderResults = (items) => {
			if (!(state.results instanceof HTMLElement)) {
				return;
			}

			state.items = items;
			if (!items.length) {
				renderEmptyState();
				return;
			}

			state.activeIndex = 0;
			const pageCount = items.filter((item) => item.kind === "page").length;
			const sectionCount = items.length - pageCount;
			const breakdown = [
				pageCount > 0 ? `文章页 ${pageCount}` : "",
				sectionCount > 0 ? `段落定位 ${sectionCount}` : "",
			]
				.filter(Boolean)
				.join(" · ");
			state.results.innerHTML = `
				<div class="owen-search-results__head">
					<div class="owen-search-results__summary-group">
						<div class="owen-search-results__summary">搜索结果</div>
						<div class="owen-search-results__breakdown">${breakdown || "已匹配相关内容"}</div>
					</div>
					<div class="owen-search-results__meta">${items.length} 条结果</div>
				</div>
				<div class="owen-search-results-list" role="listbox">
					${items
						.map((item, index) => {
							const kindLabel = item.kind === "section" ? "段落定位" : "文章页";
							const scopeLabel = highlightQuery(item.pageTitle, state.keyword);
							const contextChips = [
								item.parentTitle
									? `<span class="owen-search-result__context-chip">${highlightQuery(item.parentTitle, state.keyword)}</span>`
									: "",
								item.breadcrumb && item.breadcrumb !== item.title
									? `<span class="owen-search-result__context-chip">${highlightQuery(item.breadcrumb, state.keyword)}</span>`
									: "",
							]
								.filter(Boolean)
								.join("");
							const locationLabel =
								item.kind === "section"
									? `跳转到该段落`
									: `打开文章页`;
							const contextMarkup = contextChips
								? `<div class="owen-search-result__context">${contextChips}</div>`
								: "";

							return `
								<button
									type="button"
									class="owen-search-result${index === 0 ? " is-active" : ""}"
									data-search-result-index="${index}"
									data-search-url="${escapeHtml(item.url)}"
									role="option"
									aria-selected="${index === 0 ? "true" : "false"}"
								>
									<div class="owen-search-result__main">
										<div class="owen-search-result__meta-row">
											<span class="owen-search-result__kind">${kindLabel}</span>
											<span class="owen-search-result__scope">${scopeLabel}</span>
										</div>
										<div class="owen-search-result__title">${highlightQuery(item.title, state.keyword)}</div>
										<div class="owen-search-result__location">${highlightQuery(item.breadcrumb || item.pageTitle, state.keyword)}</div>
										${contextMarkup}
										<div class="owen-search-result__excerpt">${highlightQuery(item.excerpt, state.keyword)}</div>
									</div>
									<div class="owen-search-result__aside">
										<span class="owen-search-result__action" aria-hidden="true">Enter</span>
										<span class="owen-search-result__jump">${locationLabel}</span>
									</div>
								</button>
							`;
						})
						.join("")}
				</div>
			`;
			syncActiveResult();
		};

		const openDialog = () => {
			if (!refreshDom()) {
				return;
			}
			setDialogState(true);
			if (state.keyword.trim()) {
				renderLoadingState();
				scheduleSearch(state.keyword);
			} else {
				renderIdleState();
			}
			focusInput();
		};

		const closeDialog = () => {
			setDialogState(false);
		};

		const performSearch = async (value) => {
			const normalizedKeyword = String(value || "").trim().slice(0, 120);
			state.keyword = normalizedKeyword;

			if (state.input instanceof HTMLInputElement) {
				state.input.value = normalizedKeyword;
			}

			if (!normalizedKeyword) {
				renderIdleState();
				return;
			}

			const requestId = state.requestId + 1;
			state.requestId = requestId;
			renderLoadingState();

			try {
				state.activeController?.abort();
				state.activeController = new AbortController();
				const response = await fetch(
					`${searchApiUrl}?q=${encodeURIComponent(normalizedKeyword)}`,
					{
						credentials: "same-origin",
						signal: state.activeController.signal,
					},
				);

				if (!response.ok) {
					throw new Error(`Search request failed with ${response.status}`);
				}

				const payload = await response.json();
				if (requestId !== state.requestId) {
					return;
				}
				renderResults(Array.isArray(payload.items) ? payload.items : []);
			} catch (error) {
				if (error instanceof DOMException && error.name === "AbortError") {
					return;
				}
				console.error("Search request failed:", error);
				renderEmptyState();
			}
		};

		const scheduleSearch = (value) => {
			window.clearTimeout(state.debounceTimer);
			state.debounceTimer = window.setTimeout(() => {
				performSearch(value);
			}, 180);
		};

		const moveActiveResult = (direction) => {
			if (!Array.isArray(state.items) || state.items.length === 0) {
				return;
			}

			const nextIndex =
				(state.activeIndex + direction + state.items.length) % state.items.length;
			state.activeIndex = nextIndex;
			syncActiveResult();
		};

		const openResult = (targetUrl) => {
			if (!targetUrl) {
				return;
			}

			closeDialog();

			const resolvedUrl = new URL(targetUrl, window.location.origin);
			const currentUrl = new URL(window.location.href);
			if (
				resolvedUrl.pathname === currentUrl.pathname &&
				resolvedUrl.search === currentUrl.search &&
				resolvedUrl.hash
			) {
				const targetId = decodeURIComponent(resolvedUrl.hash.slice(1));
				const targetElement = document.getElementById(targetId);
				if (targetElement) {
					window.history.pushState({}, "", `${resolvedUrl.pathname}${resolvedUrl.search}${resolvedUrl.hash}`);
					targetElement.scrollIntoView({ behavior: "smooth", block: "start" });
					targetElement.classList.add("owen-search-target-flash");
					window.setTimeout(() => {
						targetElement.classList.remove("owen-search-target-flash");
					}, 1800);
					return;
				}
			}

			window.location.href = resolvedUrl.toString();
		};

		const openActiveResult = () => {
			const activeItem = state.items[state.activeIndex];
			if (!activeItem) {
				return;
			}
			openResult(activeItem.url);
		};

		const isEditableTarget = (target) => {
			if (!(target instanceof HTMLElement)) {
				return false;
			}

			return Boolean(
				target.closest(
					"input, textarea, select, [contenteditable='true'], [contenteditable='']",
				),
			);
		};

		const bindDomEvents = () => {
			if (!refreshDom()) {
				return;
			}

			if (
				state.desktopTrigger instanceof HTMLButtonElement &&
				state.desktopTrigger.dataset.owenSearchBound !== "true"
			) {
				state.desktopTrigger.dataset.owenSearchBound = "true";
				state.desktopTrigger.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();
					openDialog();
				});
			}

			if (
				state.mobileTrigger instanceof HTMLButtonElement &&
				state.mobileTrigger.dataset.owenSearchBound !== "true"
			) {
				state.mobileTrigger.dataset.owenSearchBound = "true";
				state.mobileTrigger.addEventListener("click", (event) => {
					event.preventDefault();
					event.stopPropagation();
					openDialog();
				});
			}

			if (
				state.backdrop instanceof HTMLButtonElement &&
				state.backdrop.dataset.owenSearchBound !== "true"
			) {
				state.backdrop.dataset.owenSearchBound = "true";
				state.backdrop.addEventListener("click", closeDialog);
			}

			if (
				state.closeButton instanceof HTMLButtonElement &&
				state.closeButton.dataset.owenSearchBound !== "true"
			) {
				state.closeButton.dataset.owenSearchBound = "true";
				state.closeButton.addEventListener("click", closeDialog);
			}

			if (
				state.panel instanceof HTMLElement &&
				state.panel.dataset.owenSearchBound !== "true"
			) {
				state.panel.dataset.owenSearchBound = "true";
				state.panel.addEventListener("click", (event) => {
					event.stopPropagation();
				});
			}

			if (
				state.input instanceof HTMLInputElement &&
				state.input.dataset.owenSearchBound !== "true"
			) {
				state.input.dataset.owenSearchBound = "true";
				state.input.addEventListener("compositionstart", () => {
					state.isComposing = true;
				});
				state.input.addEventListener("compositionend", (event) => {
					state.isComposing = false;
					const target = event.target;
					if (target instanceof HTMLInputElement) {
						scheduleSearch(target.value);
					}
				});
				state.input.addEventListener("input", (event) => {
					if (state.isComposing) {
						return;
					}
					const target = event.target;
					if (target instanceof HTMLInputElement) {
						scheduleSearch(target.value);
					}
				});
				state.input.addEventListener("keydown", (event) => {
					if (event.key === "ArrowDown") {
						event.preventDefault();
						moveActiveResult(1);
						return;
					}
					if (event.key === "ArrowUp") {
						event.preventDefault();
						moveActiveResult(-1);
						return;
					}
					if (event.key === "Enter") {
						event.preventDefault();
						openActiveResult();
						return;
					}
					if (event.key === "Escape") {
						event.preventDefault();
						closeDialog();
					}
				});
			}

			if (
				state.results instanceof HTMLElement &&
				state.results.dataset.owenSearchBound !== "true"
			) {
				state.results.dataset.owenSearchBound = "true";
				state.results.addEventListener("click", (event) => {
					const target = event.target;
					if (!(target instanceof Element)) {
						return;
					}

					const resultButton = target.closest("[data-search-url]");
					if (!(resultButton instanceof HTMLElement)) {
						return;
					}

					event.preventDefault();
					openResult(resultButton.dataset.searchUrl || "");
				});
				state.results.addEventListener("mousemove", (event) => {
					const target = event.target;
					if (!(target instanceof Element)) {
						return;
					}

					const resultButton = target.closest("[data-search-result-index]");
					if (!(resultButton instanceof HTMLElement)) {
						return;
					}

					const nextIndex = Number(resultButton.dataset.searchResultIndex || "-1");
					if (Number.isNaN(nextIndex) || nextIndex === state.activeIndex) {
						return;
					}

					state.activeIndex = nextIndex;
					syncActiveResult();
				});
			}
		};

		const handleGlobalKeydown = (event) => {
			const target = event.target;
			const isShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k";

			if (isShortcut && !isEditableTarget(target)) {
				event.preventDefault();
				if (state.isOpen) {
					closeDialog();
				} else {
					openDialog();
				}
				return;
			}

			if (event.key === "Escape" && state.isOpen) {
				event.preventDefault();
				closeDialog();
			}
		};

		const handlePageLifecycle = () => {
			window.clearTimeout(state.debounceTimer);
			closeDialog();
			window.setTimeout(() => {
				refreshDom();
				bindDomEvents();
				if (state.keyword.trim()) {
					performSearch(state.keyword);
				} else {
					renderIdleState();
				}
			}, 0);
		};

		if (!state.globalListenersBound) {
			state.globalListenersBound = true;
			document.addEventListener("keydown", handleGlobalKeydown);
			window.addEventListener("pageshow", handlePageLifecycle);
			document.addEventListener("swup:page:view", handlePageLifecycle);
			document.addEventListener("owen-blog:page:loaded", handlePageLifecycle);
		}

		refreshDom();
		bindDomEvents();
		renderIdleState();
	})();
</script>
